<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Student Details</title>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Source+Serif+4:wght@500;600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

<style>
  /* =========================
     RESET / BASE
     ========================= */
  * { box-sizing: border-box; }

  html, body {
    margin: 0;
    padding: 0;
    background: #FFFFFF;
  }

  body {
    font-family: 'Inter', Arial, Helvetica, sans-serif;
    color: #1C1B1F;
  }

  /* =========================
     PAGE (Puppeteer: set pageSize A4 / Letter in printToPDF options)
     ========================= */
  .pdf-page {
    width: 100%;
    min-height: 100vh;
    padding: 64px 72px;
    display: flex;
    flex-direction: column;
    page-break-after: always;
    break-after: page;
  }

  .pdf-page:last-child {
    page-break-after: auto;
    break-after: auto;
  }

  /* =========================
     PAGE 1 — DETAILS FORM
     ========================= */

  .doc-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    border-bottom: 3px solid #14213D;
    padding-bottom: 18px;
    margin-bottom: 34px;
  }

  .doc-header .eyebrow {
    font-size: 11.5px;
    font-weight: 600;
    letter-spacing: 1.6px;
    text-transform: uppercase;
    color: #6B6E76;
    margin-bottom: 6px;
  }

  .doc-header h1 {
    margin: 0;
    font-family: 'Source Serif 4', Georgia, serif;
    font-size: 30px;
    font-weight: 700;
    color: #14213D;
  }

  .doc-header .doc-id {
    text-align: right;
    font-size: 12.5px;
    color: #6B6E76;
    line-height: 1.6;
  }

  .doc-main {
    margin-top: 56px;
  }

  .doc-body {
    width: 100%;
    display: flex;
    gap: 48px;
  }

  /* --- Photo block --- */
  .photo-block {
    flex: 0 0 188px;
  }

  .photo-frame {
    width: 188px;
    height: 232px;
    border: 1px solid #D8D6DE;
    background: #F6F5F8;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .photo-frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .photo-frame .photo-fallback {
    display: none;
    color: #B3B0BC;
  }

  .photo-frame .photo-fallback svg {
    width: 52px;
    height: 52px;
  }

  .photo-caption {
    margin-top: 8px;
    font-size: 11px;
    color: #9A97A3;
    text-align: center;
    letter-spacing: 0.4px;
    text-transform: uppercase;
  }

  /* --- Form fields --- */
  .fields {
    flex: 1;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 36px 36px;
  }

  .field {
    border-bottom: 1px solid #E3E1E8;
    padding-bottom: 14px;
  }

  .field.full {
    grid-column: 1 / -1;
    padding-bottom: 22px;
  }

  .field.full .field-value {
    font-size: 22px;
  }

  .field-label {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: #8A8792;
    margin-bottom: 7px;
  }

  .field-value {
    font-size: 16.5px;
    font-weight: 600;
    color: #1C1B1F;
  }

  /* --- Footer --- */
  .doc-footer {
    margin-top: auto;
    padding-top: 20px;
    border-top: 1px solid #E3E1E8;
    display: flex;
    justify-content: space-between;
    font-size: 11px;
    color: #9A97A3;
  }

  /* =========================
     IMAGE PAGES
     ========================= */
  .visual-page {
    display: flex;
    flex-direction: column;
  }

  .visual-page .page-eyebrow {
    font-size: 11.5px;
    font-weight: 600;
    letter-spacing: 1.6px;
    text-transform: uppercase;
    color: #8A8792;
    margin-bottom: 6px;
  }

  .visual-page h2 {
    margin: 0 0 32px;
    font-family: 'Source Serif 4', Georgia, serif;
    font-size: 24px;
    font-weight: 700;
    color: #14213D;
    border-bottom: 2px solid #14213D;
    padding-bottom: 14px;
  }

  .visual-page .img-frame {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid #E3E1E8;
    border-radius: 6px;
    background: #FAFAFB;
    padding: 20px;
  }

  .visual-page img {
    max-width: 100%;
    max-height: 60vh;
    object-fit: contain;
    display: block;
  }

  @media (max-width: 420px) {
    .pdf-page { padding: 28px 20px; }
    .doc-body { flex-direction: column; }
    .fields { grid-template-columns: 1fr; }
  }
</style>
</head>

<body>

  <!-- =========================
       PAGE 1 — STUDENT DETAILS FORM
       ========================= -->
  <div class="pdf-page">

    <div class="doc-header">
      <div>
        <div class="eyebrow">Student Record</div>
        <h1>Student Details</h1>
      </div>
      <div class="doc-id">
        Record No. {{ registerNumber }}
      </div>
    </div>

    <div class="doc-main">
    <div class="doc-body">

      <div class="photo-block">
        <div class="photo-frame">
          <img
            src="{{ profileImage }}"
            alt="{{ name }}"
            onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
          >
          <div class="photo-fallback">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <circle cx="12" cy="8" r="4" />
              <path d="M20 5.5c-2.5-1-5-1-7 0v13c2-1 4.5-1 7 0v-13Z" stroke-linejoin="round" />
            </svg>
          </div>
        </div>
        <div class="photo-caption">Photograph</div>
      </div>

      <div class="fields">

        <div class="field full">
          <div class="field-label">Full Name</div>
          <div class="field-value">{{ name }}</div>
        </div>

        <div class="field">
          <div class="field-label">Register Number</div>
          <div class="field-value">{{ registerNumber }}</div>
        </div>

        <div class="field">
          <div class="field-label">Course</div>
          <div class="field-value">{{ course }}</div>
        </div>

        <div class="field">
          <div class="field-label">Semester</div>
          <div class="field-value">{{ semester }}</div>
        </div>

      </div>

    </div>
    </div>

   

  </div>


  <!-- =========================
       PAGE 2
       ========================= -->
  <div class="pdf-page visual-page">
    <div class="page-eyebrow">Section 02</div>
    <h2>Academic Performance</h2>
    <div class="img-frame">
      <img src="{{ image2 }}" alt="Academic Performance">
    </div>
  </div>


  <!-- =========================
       PAGE 3
       ========================= -->
  <div class="pdf-page visual-page">
    <div class="page-eyebrow">Section 03</div>
    <h2>Student Activities</h2>
    <div class="img-frame">
      <img src="{{ image3 }}" alt="Student Activities">
    </div>
  </div>


  <!-- =========================
       PAGE 4
       ========================= -->
  <div class="pdf-page visual-page">
    <div class="page-eyebrow">Section 04</div>
    <h2>Campus Activities</h2>
    <div class="img-frame">
      <img src="{{ image4 }}" alt="Campus Activities">
    </div>
  </div>


  <!-- =========================
       PAGE 5
       ========================= -->
  <div class="pdf-page visual-page">
    <div class="page-eyebrow">Section 05</div>
    <h2>Graduation</h2>
    <div class="img-frame">
      <img src="{{ image5 }}" alt="Graduation">
    </div>
  </div>

</body>
</html>
