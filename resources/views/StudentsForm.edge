<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Student Details</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
  <style>
    * { box-sizing: border-box; }
    body {
      margin: 0;
      padding: 60px 24px;
      font-family: 'Inter', Arial, Helvetica, sans-serif;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      background: #0A0116;
      background-image:
        radial-gradient(circle at 18% 20%, rgba(255, 0, 200, 0.28), transparent 42%),
        radial-gradient(circle at 85% 15%, rgba(0, 224, 255, 0.22), transparent 40%),
        radial-gradient(circle at 75% 90%, rgba(140, 0, 255, 0.30), transparent 45%),
        linear-gradient(160deg, #0A0116, #120324 60%, #0A0116);
    }
    .card-wrap {
      position: relative;
      width: 100%;
      max-width: 380px;
      border-radius: 34px;
      padding: 2px;
      background: linear-gradient(135deg, #FF2E9A, #8A2BE2 45%, #00E0FF 100%);
      box-shadow:
        0 0 22px rgba(255, 46, 154, 0.45),
        0 0 46px rgba(0, 224, 255, 0.30),
        0 30px 60px rgba(0, 0, 0, 0.55);
    }
    .card {
      width: 100%;
      background: #120A24;
      border-radius: 32px;
      overflow: hidden;
    }
    /* ===== PHOTO ===== */
    .photo {
      position: relative;
      width: 100%;
      height: 260px;
      background: linear-gradient(135deg, #2A1246, #170A2E);
      overflow: hidden;
    }
    .photo img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      filter: saturate(1.08) contrast(1.03);
    }
    .photo-fallback {
      display: none;
      width: 100%;
      height: 100%;
      align-items: center;
      justify-content: center;
      color: rgba(255,255,255,0.6);
    }
    .photo-fallback svg { width: 64px; height: 64px; }
    .id-pill {
      position: absolute;
      top: 18px;
      left: 18px;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 7px 13px;
      border-radius: 20px;
      background: rgba(10, 1, 22, 0.55);
      backdrop-filter: blur(6px);
      border: 1px solid rgba(0, 224, 255, 0.55);
      color: #6BEEFF;
      font-size: 11px;
      font-weight: 600;
      letter-spacing: 1.2px;
      text-transform: uppercase;
      text-shadow: 0 0 8px rgba(0, 224, 255, 0.8);
    }
    .id-pill svg { width: 13px; height: 13px; filter: drop-shadow(0 0 4px rgba(0,224,255,0.9)); }
    .photo-fade {
      position: absolute;
      left: 0; right: 0; bottom: 0;
      height: 90px;
      background: linear-gradient(to top, #120A24, rgba(18,10,36,0));
      pointer-events: none;
    }
    .info {
      padding: 26px 28px 22px;
    }
    .info h1 {
      margin: 0 0 16px;
      font-family: 'Poppins', sans-serif;
      font-size: 25px;
      font-weight: 700;
      color: #FFFFFF;
      text-shadow:
        0 0 10px rgba(255, 46, 154, 0.55),
        0 0 22px rgba(255, 46, 154, 0.28);
    }
    .info-row {
      display: flex;
      align-items: center;
      gap: 10px;
      margin-bottom: 10px;
      color: #B9AFCC;
      font-size: 14.5px;
    }
    .info-row svg {
      width: 17px;
      height: 17px;
      color: #00E0FF;
      flex-shrink: 0;
      filter: drop-shadow(0 0 5px rgba(0, 224, 255, 0.65));
    }
    .info-row span {
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
    /* ===== STATS ===== */
    .stats {
      display: flex;
      border-top: 1px solid rgba(255, 255, 255, 0.08);
      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
      margin: 6px 28px 18px;
    }
    .stat {
      flex: 1;
      text-align: center;
      padding: 18px 6px;
    }
    .stat:first-child {
      border-right: 1px solid rgba(255, 255, 255, 0.08);
    }
    .stat-value {
      font-family: 'Poppins', sans-serif;
      font-size: 22px;
      font-weight: 700;
      color: #6BEEFF;
      text-shadow: 0 0 10px rgba(0, 224, 255, 0.75), 0 0 22px rgba(0, 224, 255, 0.35);
    }
    .stat-value.verified-value {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      color: #5CFFA8;
      text-shadow: 0 0 10px rgba(92, 255, 168, 0.75), 0 0 22px rgba(92, 255, 168, 0.35);
    }
    .stat-value.verified-value svg {
      width: 18px;
      height: 18px;
      filter: drop-shadow(0 0 6px rgba(92, 255, 168, 0.85));
    }
    .stat-label {
      margin-top: 5px;
      font-size: 12px;
      color: #83789A;
      letter-spacing: 0.3px;
    }
    /* ===== FOOTER ===== */
    .menu {
      padding: 4px 28px 26px;
    }
    .menu-row {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 8px 0;
      color: #C9C0DA;
      font-size: 13.5px;
      font-weight: 500;
    }
    .menu-row svg {
      width: 18px;
      height: 18px;
      color: #FF2E9A;
      flex-shrink: 0;
      filter: drop-shadow(0 0 5px rgba(255, 46, 154, 0.65));
    }
    .menu-row .badge {
      margin-left: auto;
      font-size: 11.5px;
      font-weight: 700;
      color: #5CFFA8;
      background: rgba(92, 255, 168, 0.10);
      border: 1px solid rgba(92, 255, 168, 0.35);
      padding: 4px 10px;
      border-radius: 12px;
      text-shadow: 0 0 6px rgba(92, 255, 168, 0.6);
    }
    @media (max-width: 420px) {
      body { padding: 32px 16px; }
      .photo { height: 220px; }
    }
  </style>
</head>
<body>
  <div class="card-wrap">
    <div class="card">
      <!-- PHOTO -->
      <div class="photo">
        <img
          src="{{ profileImage }}"
          alt="{{ name }}"
          onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
        >
        <div class="photo-fallback">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <circle cx="12" cy="8" r="4"/>
            <path d="M4 20c0-4 3.6-6 8-6s8 2 8 6" stroke-linecap="round"/>
          </svg>
        </div>
        <div class="id-pill">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M12 3 2 8l10 5 10-5-10-5Z" stroke-linejoin="round"/>
          </svg>
          Student ID
        </div>
        <div class="photo-fade"></div>
      </div>
      <!-- INFO -->
      <div class="info">
        <h1>{{ name }}</h1>
        <div class="info-row">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
            <rect x="3.5" y="5" width="17" height="14" rx="2.4"/>
            <path d="M7 9.5h4M7 13h7" stroke-linecap="round"/>
          </svg>
          <span>{{ registerNumber }}</span>
        </div>
        <div class="info-row">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
            <path d="M4 5.5c2.5-1 5-1 7 0v13c-2-1-4.5-1-7 0v-13Z" stroke-linejoin="round"/>
            <path d="M20 5.5c-2.5-1-5-1-7 0v13c2-1 4.5-1 7 0v-13Z" stroke-linejoin="round"/>
          </svg>
          <span>{{ course }}</span>
        </div>
      </div>
      <!-- STATS -->
      <div class="stats">
        <div class="stat">
          <div class="stat-value">{{ semester }}</div>
          <div class="stat-label">Semester</div>
        </div>
        <div class="stat">
          <div class="stat-value verified-value">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4">
              <path d="M5 12.5 9.5 17 19 7" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            Verified
          </div>
          <div class="stat-label">Status</div>
        </div>
      </div>

      <!-- FOOTER -->
      <div class="menu">
        <div class="menu-row">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7">
            <circle cx="12" cy="12" r="9"/>
            <path d="M8.5 12.5 11 15l4.5-6" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          Official Academic Record
          <span class="badge">✓ Verified</span>
        </div>
      </div>

    </div>
  </div>

</body>

</html>
